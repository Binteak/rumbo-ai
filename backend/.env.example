# Sin ANTHROPIC_API_KEY la app arranca en modo demo (sin coste).
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_MODE=auto
DATABASE_URL=sqlite:///./rumbo.db
CORS_ORIGINS=http://localhost:4200
DEMO_DELAY_MS=700
# Producción / varias réplicas:
# DATABASE_URL=postgresql+psycopg://rumbo:rumbo@localhost:5432/rumbo
# REDIS_URL=redis://localhost:6379/0
