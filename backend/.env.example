# Modelos: se usan en cadena todos los que tengan clave, en este orden. Si uno agota su cuota o no
# responde, el turno sigue con el siguiente; al final, el modo demo (sin coste).
#   ANTHROPIC_API_KEY → Claude · GEMINI_API_KEY → Gemini gratis (Google AI Studio, sin tarjeta)
#   GROQ_API_KEY → Groq gratis (sin tarjeta) · EXTRA_LLM_API_KEY → cualquier API compatible con OpenAI
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Proveedor extra. Por defecto, Hugging Face (token con permiso "Inference Providers").
# Otros: OpenRouter → https://openrouter.ai/api/v1 · DeepSeek → https://api.deepseek.com
EXTRA_LLM_API_KEY=
EXTRA_LLM_NAME=huggingface
EXTRA_LLM_BASE_URL=https://router.huggingface.co/v1
EXTRA_LLM_MODEL=openai/gpt-oss-120b
AGENT_MODEL=claude-sonnet-5-5
AGENT_EFFORT=medium
AGENT_MODE=auto
DATABASE_URL=sqlite:///./rumbo.db
CORS_ORIGINS=http://localhost:4200
DEMO_DELAY_MS=700
# Protección: consultas con IA real por IP (después, modo demo) y presupuesto diario global de tokens.
RATE_LIMIT_LLM_PER_HOUR=5
RATE_LIMIT_LLM_PER_DAY=15
RATE_LIMIT_FLOOD_PER_MINUTE=20
LLM_DAILY_TOKEN_BUDGET=180000
# RAG: sin VOYAGE_API_KEY se usa un embedder local (gratis). Con PostgreSQL, los vectores van a pgvector.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# Producción / varias réplicas:
# DATABASE_URL=postgresql+psycopg://rumbo:rumbo@localhost:5432/rumbo
# REDIS_URL=redis://localhost:6379/0
