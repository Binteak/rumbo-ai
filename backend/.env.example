# Modelos gratuitos (sin tarjeta). Se usan en cadena los que tengan clave, en este orden; si uno agota
# su cuota o no responde, el turno sigue con el siguiente y, al final, en modo demo (sin coste).
#   1. Gemini   → GEMINI_API_KEY      (aistudio.google.com → Get API key)
#   2. Groq     → GROQ_API_KEY        (console.groq.com → API Keys)
#   3. DeepSeek → EXTRA_LLM_API_KEY   (openrouter.ai → Keys; usa el modelo gratuito de DeepSeek en OpenRouter)
# Claude (ANTHROPIC_API_KEY) es de pago y, si tiene clave, va el primero.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
EXTRA_LLM_API_KEY=
EXTRA_LLM_NAME=deepseek
EXTRA_LLM_BASE_URL=https://openrouter.ai/api/v1
EXTRA_LLM_MODEL=deepseek/deepseek-v4-flash:free
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-sonnet-5-5
AGENT_MODE=auto
DATABASE_URL=sqlite:///./rumbo.db
CORS_ORIGINS=http://localhost:4200
DEMO_DELAY_MS=700
# Protección: consultas con IA real por IP (después, modo demo) y presupuesto diario global de tokens.
RATE_LIMIT_LLM_PER_HOUR=5
RATE_LIMIT_LLM_PER_DAY=15
RATE_LIMIT_FLOOD_PER_MINUTE=20
LLM_DAILY_TOKEN_BUDGET=180000
# RAG: sin VOYAGE_API_KEY se usa un embedder local (gratis). Con PostgreSQL, los vectores van a pgvector.
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-4-lite
# Producción / varias réplicas:
# DATABASE_URL=postgresql+psycopg://rumbo:rumbo@localhost:5432/rumbo
# REDIS_URL=redis://localhost:6379/0

# Trazas en LangSmith (opcional): smith.langchain.com → Settings → API Keys.
# La clave real va solo en .env, que no se sube a git.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rumbo-ai
